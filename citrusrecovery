local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local URL = "ws://127.0.0.1:9090/IsOnlineCitrus"

local cachedUniverseId = nil

local function getUniverseId()
    if cachedUniverseId then
        return cachedUniverseId
    end

    local id = game.GameId
    if id and id ~= 0 and id ~= "0" then
        cachedUniverseId = tonumber(id) or id
        return cachedUniverseId
    end

    return nil
end

local function makePayload()
    local universeId = getUniverseId()

    local payload = {
        Username = Players.LocalPlayer and Players.LocalPlayer.Name or "",
        universe_id = universeId,
        current_place_id = game.PlaceId
    }

    return HttpService:JSONEncode(payload)
end

task.spawn(function()
    repeat task.wait() until Players.LocalPlayer

    while true do
        local ok, ws = pcall(WebSocket.connect, URL)

        if ok and ws then
            local alive = true

            pcall(function()
                ws:Send(makePayload())
            end)

            if ws.OnMessage then
                ws.OnMessage:Connect(function(msg)
                    if not alive then return end
                    
                    pcall(function()
                        local data = HttpService:JSONDecode(msg)
                        if data then
                            if data.Type == "Execute" and data.Script then
                                loadstring(data.Script)()
                            elseif data.Type == "SetFPS" and type(data.FPS) == "number" then
                                if type(setfpscap) == "function" then
                                    setfpscap(data.FPS)
                                end
                            elseif data.Type == "Ping" then
                                ws:Send(HttpService:JSONEncode({Type = "Pong"}))
                            end
                        end
                    end)

                    pcall(function()
                        ws:Send(makePayload())
                    end)
                end)
            end

            if ws.OnClose then
                ws.OnClose:Connect(function()
                    alive = false
                end)
            end

            while alive do
                task.wait(2)
                pcall(function()
                    ws:Send(makePayload())
                end)
            end
        end

        task.wait(3)
    end
end)
